# ============================================================
# NIDA Energy Dashboard — environment template
# ============================================================
# Copy to `.env` (used by docker-compose.yml) and/or `.env.dev`
# (used by docker-compose.dev.yml). Both real files are gitignored,
# so this template is the checklist for a fresh VM.
#
#   cp .env.example .env      # then edit every value marked REQUIRED
#
# Rule of thumb: anything the code has a sane default for is optional;
# anything that grants access or identifies the deployment is REQUIRED.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# REQUIRED — the password protects the database.
POSTGRES_DB=energy_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# REQUIRED — the backend talks to both databases. On the VM the
# host is the compose service name `db`, not localhost.
DATABASE_URL=postgresql://postgres:change-me@db:5432/energy_trading?schema=public
DATABASE_URL_DEMO=postgresql://postgres:change-me@db:5432/energy_trading_demo?schema=public

# ── Backend HTTP ─────────────────────────────────────────────
BACKEND_PORT=8000
# REQUIRED — used for CORS and for links inside notification emails.
FRONTEND_URL=http://localhost:3000
# REQUIRED on the webproxy VM — the browser calls this URL directly.
# The frontend container only writes it into window.__RUNTIME_CONFIG__ at
# startup, so it can be changed without rebuilding the image.
#   fullnode VM  -> http://localhost:8000/api   (backend is local)
#   webproxy VM  -> http://<fullnode-ip>:8000/api
# Leaving the default on webproxy points the browser at port 8000 of the
# webproxy itself, which runs no backend -> every request 502s.
BACKEND_URL=http://localhost:8000/api
# Which database the UI opens in by default: real | demo
DEFAULT_DATA_MODE=real

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED — signs every JWT. Generate with: openssl rand -hex 32
# JWT_SECRET takes precedence over SECRET_KEY; both fall back to the
# literal string 'dev-secret', which must never reach a VM.
SECRET_KEY=change-me-too
JWT_SECRET=
JWT_EXPIRES_IN=365d

# ── Seeded admin accounts (created on first boot) ────────────
# Two admins share ADMIN_EMAIL and are told apart by password.
# seedAdmin reconciles the email on every boot, so changing this
# value rewrites the admin rows in the database.
ADMIN_EMAIL=blockchain.admin@nida.ac.th
ADMIN_PASSWORD=nidaadmin1
ADMIN_PASSWORD_2=nidaadmin2

# Shared email given to every non-admin user (identity is credId,
# not email). USER_EMAIL is backend-side, VITE_USER_EMAIL is the
# frontend default shown in the registration form. NOTE: VITE_* is
# inlined at BUILD time — the frontend Dockerfile passes no build
# args, so this value only takes effect if it is changed in code.
USER_EMAIL=nida_blockchain.user@nida.ac.th
VITE_USER_EMAIL=nida_blockchain.user@nida.ac.th

# ── Outgoing email ───────────────────────────────────────────
# The transport is chosen by credential, in this order:
#   1. GMAIL_USER + GMAIL_PASS   (service: gmail)
#   2. SMTP_HOST                 (custom relay, e.g. Office 365)
# Leaving GMAIL_USER set means SMTP_HOST is ignored — clear both
# GMAIL_* vars if you switch to a relay.
GMAIL_USER=
GMAIL_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Displayed From address. It must belong to the domain you
# authenticate as, otherwise nida.ac.th publishes DMARC p=reject and
# mail is refused outright. Leave empty to reuse the transport account.
MAIL_FROM=

# ── Energy feed (real meters at NIDA) ────────────────────────
ENERGY_FEED_ENABLED=true
ENERGY_FEED_URL=http://10.10.161.239:8089
ENERGY_FEED_INTERVAL_SEC=60
ENERGY_FEED_BUILDING_MAP={"RAT":"ratchaphruek","AUD":"auditorium","MAL":"malai"}

# ── Mock data generator ──────────────────────────────────────
MOCK_ENERGY_CRON=0 * * * *

# ── Blockchain ───────────────────────────────────────────────
ETH_RPC_URL=http://blockchain:8545
ETH_CHAIN_ID=31337
# REQUIRED once receipts are verified on-chain.
ETH_PRIVATE_KEY=
ETH_EXPLORER_BASE_URL=
ETH_VERIFICATION_CONTRACT_ADDRESS=

# ── Market / trading parameters ──────────────────────────────
MARKET_BASELINE_PRICE=4
MARKET_BID_MIN_PRICE=
MARKET_OFFER_MAX_PRICE=
MARKET_PENALTY_PRICE=
MARKET_FORCE_DISTRIBUTE=false
PROMPTPAY_ID=

# ── Notifications ────────────────────────────────────────────

# ── pgAdmin (tooling only, not part of the product) ──────────
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@nida.local
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_SERVER_MODE=True

# ── Ports ────────────────────────────────────────────────────
BLOCKCHAIN_PORT=8545

# ── Container orchestration ──────────────────────────────────
# Only meaningful when running `prisma migrate deploy` instead of
# `prisma db push`. The default startup path uses db push.
RUN_PRISMA_MIGRATE=false
