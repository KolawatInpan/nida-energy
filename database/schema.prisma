generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  USER
  ADMIN
}
  // LOG / NOTIFICATION
  //////////////////////////////////////////////////////


enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum EnergyOfferStatus {
  AVAILABLE
  BOUGHT
  CANCELLED
  SOLD
}

enum MarketType {
  DAY_AHEAD
  INTRADAY
  MANUAL
}

enum EnergyBidStatus {
  OPEN
  FULFILLED
  CANCELLED
}

//////////////////////////////////////////////////////
// USER / AUTH
//////////////////////////////////////////////////////

model User {
  credId        String   @db.Uuid @unique
  name          String
  email         String   @id @unique
  passwordHash  String
  address       String?
  telNum        String?
  lineID        String?
  position      String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credentials   UserCredential[]
  buildings     Building[]
  wallets       Wallet[]
  marketOrders  MarketOrder[] @relation("MarketOrderParticipant")
}

model UserCredential {
  credId     String   @db.Uuid
  type       String
  identifier String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [credId], references: [credId])

  @@id([credId, type])
}

//////////////////////////////////////////////////////
// BUILDING / METER
//////////////////////////////////////////////////////

model Building {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  mapURL    String?
  address   String?
  province  String?
  postal    String?
  status    String?
  energy    Decimal? @db.Decimal(12, 4)
  email     String

  produceSN String?
  consumeSN String?
  batSN     String?
  tradeMode String   @default("MANUAL")
  tradeMeterType String @default("produce")
  batterySellThreshold Float @default(80)
  solarSelfPercent Float? @default(80)
  solarTradeMode String?
  batteryTradeMode String?
  batteryBidPrice Float?
  batteryOfferPrice Float?
  solarOfferPrice Float?

  createdAt DateTime @default(now())

  owner User @relation(fields: [email], references: [email])
  meters MeterInfo[]
  transactions Transaction[]
  marketOrders MarketOrder[] @relation("MarketOrderBuilding")
}

model MeterInfo {
  snid           String   @unique
  requestId     String?
  buildingName  String
  value         Decimal? @db.Decimal(12, 4)
  capacity      Decimal? @db.Decimal(12, 4)
  timestamp     DateTime?
  type String
  dateInstalled DateTime?
  dateSubmit    DateTime?
  approveStatus String
  
  kWH           Decimal? @db.Decimal(12, 4)
  isAutoMock    Boolean  @default(false)
  mockProfile   String   @default("sinusoidal")

  building Building @relation(fields: [buildingName], references: [name])
  hourlyEnergy  HourlyEnergy[]
  dailyEnergy   DailyEnergy[]
  weeklyEnergy  WeeklyEnergy[]
  monthlyEnergy MonthlyEnergy[]
  runningMeter RunningMeter[]
}

//////////////////////////////////////////////////////
// ENERGY AGGREGATION
//////////////////////////////////////////////////////

model RunningMeter {
  id        String   @id @default(uuid())
  snid      String
  txid      String?
  timestamp DateTime
  kW        Decimal? @db.Decimal(12, 4)
  kWH       Decimal? @db.Decimal(12, 4)
  source    String?  // "SOLAR" | "MARKET" | "GRID" | "MANUAL" — where battery charge came from

  meter MeterInfo @relation(fields: [snid], references: [snid])

  @@index([snid])
  @@index([snid, timestamp])
  @@unique([snid, timestamp])
}

model HourlyEnergy {
  meterSnid String
  date      DateTime @db.Date

  h0  Decimal? @db.Decimal(12, 4)
  h1  Decimal? @db.Decimal(12, 4)
  h2  Decimal? @db.Decimal(12, 4)
  h3  Decimal? @db.Decimal(12, 4)
  h4  Decimal? @db.Decimal(12, 4)
  h5  Decimal? @db.Decimal(12, 4)
  h6  Decimal? @db.Decimal(12, 4)
  h7  Decimal? @db.Decimal(12, 4)
  h8  Decimal? @db.Decimal(12, 4)
  h9  Decimal? @db.Decimal(12, 4)
  h10 Decimal? @db.Decimal(12, 4)
  h11 Decimal? @db.Decimal(12, 4)
  h12 Decimal? @db.Decimal(12, 4)
  h13 Decimal? @db.Decimal(12, 4)
  h14 Decimal? @db.Decimal(12, 4)
  h15 Decimal? @db.Decimal(12, 4)
  h16 Decimal? @db.Decimal(12, 4)
  h17 Decimal? @db.Decimal(12, 4)
  h18 Decimal? @db.Decimal(12, 4)
  h19 Decimal? @db.Decimal(12, 4)
  h20 Decimal? @db.Decimal(12, 4)
  h21 Decimal? @db.Decimal(12, 4)
  h22 Decimal? @db.Decimal(12, 4)
  h23 Decimal? @db.Decimal(12, 4)

  kwh Decimal @default(0) @db.Decimal(12, 4)

  meter MeterInfo @relation(fields: [meterSnid], references: [snid])

  @@id([meterSnid, date])
}

model DailyEnergy {
  meterSnid String
  year Int
  month Int

  d1  Decimal? @db.Decimal(12, 4)
  d2  Decimal? @db.Decimal(12, 4)
  d3  Decimal? @db.Decimal(12, 4)
  d4  Decimal? @db.Decimal(12, 4)
  d5  Decimal? @db.Decimal(12, 4)
  d6  Decimal? @db.Decimal(12, 4)
  d7  Decimal? @db.Decimal(12, 4)
  d8  Decimal? @db.Decimal(12, 4)
  d9  Decimal? @db.Decimal(12, 4)
  d10 Decimal? @db.Decimal(12, 4)
  d11 Decimal? @db.Decimal(12, 4)
  d12 Decimal? @db.Decimal(12, 4)
  d13 Decimal? @db.Decimal(12, 4)
  d14 Decimal? @db.Decimal(12, 4)
  d15 Decimal? @db.Decimal(12, 4)
  d16 Decimal? @db.Decimal(12, 4)
  d17 Decimal? @db.Decimal(12, 4)
  d18 Decimal? @db.Decimal(12, 4)
  d19 Decimal? @db.Decimal(12, 4)
  d20 Decimal? @db.Decimal(12, 4)
  d21 Decimal? @db.Decimal(12, 4)
  d22 Decimal? @db.Decimal(12, 4)
  d23 Decimal? @db.Decimal(12, 4)
  d24 Decimal? @db.Decimal(12, 4)
  d25 Decimal? @db.Decimal(12, 4)
  d26 Decimal? @db.Decimal(12, 4)
  d27 Decimal? @db.Decimal(12, 4)
  d28 Decimal? @db.Decimal(12, 4)
  d29 Decimal? @db.Decimal(12, 4)
  d30 Decimal? @db.Decimal(12, 4)
  d31 Decimal? @db.Decimal(12, 4)

  kwh Decimal @default(0) @db.Decimal(12, 4)

  meter MeterInfo @relation(fields: [meterSnid], references: [snid])

  @@id([meterSnid, year, month])
}

model WeeklyEnergy {
  meterSnid String
  year Int
  week Int

  sun Decimal? @db.Decimal(12, 4)
  mon Decimal? @db.Decimal(12, 4)
  tue Decimal? @db.Decimal(12, 4)
  wed Decimal? @db.Decimal(12, 4)
  thu Decimal? @db.Decimal(12, 4)
  fri Decimal? @db.Decimal(12, 4)
  sat Decimal? @db.Decimal(12, 4)

  kwh Decimal @default(0) @db.Decimal(12, 4)

  meter MeterInfo @relation(fields: [meterSnid], references: [snid])

  @@id([meterSnid, year, week])
}

model MonthlyEnergy {
  meterSnid String
  year      Int

  M1  Decimal? @db.Decimal(12, 4)
  M2  Decimal? @db.Decimal(12, 4)
  M3  Decimal? @db.Decimal(12, 4)
  M4  Decimal? @db.Decimal(12, 4)
  M5  Decimal? @db.Decimal(12, 4)
  M6  Decimal? @db.Decimal(12, 4)
  M7  Decimal? @db.Decimal(12, 4)
  M8  Decimal? @db.Decimal(12, 4)
  M9  Decimal? @db.Decimal(12, 4)
  M10 Decimal? @db.Decimal(12, 4)
  M11 Decimal? @db.Decimal(12, 4)
  M12 Decimal? @db.Decimal(12, 4)

  kwh Decimal @default(0) @db.Decimal(12, 4)

  meter MeterInfo @relation(fields: [meterSnid], references: [snid])

  @@id([meterSnid, year])
}

//////////////////////////////////////////////////////
// WALLET / TRANSACTION
//////////////////////////////////////////////////////

model Wallet {
  id           String   @id
  email        String @unique
  encryptedKey String?
  isCustodial  Boolean  @default(false)
  chain        String   @default("ganache")
  tokenBalance Float    @default(0)
  quota        Float?

  user         User @relation(fields: [email], references: [email])
  txs          WalletTx[]
  transactions Transaction[]
}

model WalletTx {
  id         String   @id
  walletId   String
  timestamp  DateTime @default(now())
  tokenInOut Float

  wallet Wallet @relation(fields: [walletId], references: [id])
}

//////////////////////////////////////////////////////
// INVOICE / RECEIPT
//////////////////////////////////////////////////////

model Invoice {
  id           String   @id
  buildingName String
  fromWId      String
  toWId        String
  timestamp    DateTime
  kWH          Float?
  tokenAmount  Float?
  status String // paid, late, cancelled
  month        Int
  year         Int
  dailyAvg     Float?
  peakDate     DateTime?
  peakkWH      Float?

  receipt Receipt?
}

model Receipt {
  id         String   @id
  invoiceId  String @unique
  timestamp  DateTime
  walletTxId String

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

//////////////////////////////////////////////////////
// ENERGY MARKET
//////////////////////////////////////////////////////

model EnergyOffer {
  id             Int      @id @default(autoincrement())
  sellerWalletId String
  buyerWalletId  String?
  kWH            Float
  kWHSold        Float  @default(0)
  ratePerkWH     Float
  totalPrice     Float
  status         EnergyOfferStatus @default(AVAILABLE)
  marketType     MarketType @default(MANUAL)
  sourceType     String?  // e.g. produce, battery — used to restore energy on cancel
  targetDate     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sellerWalletId])
  @@index([status])
}

model EnergyBid {
  id             Int             @id @default(autoincrement())
  buyerWalletId  String
  kWH            Float
  kWHBought      Float           @default(0)
  ratePerkWH     Float?          // อนุญาตให้เป็น Null ได้ ถ้ายอมรับการซื้อในราคาตลาด (Market Price)
  status         EnergyBidStatus @default(OPEN)
  marketType     MarketType      @default(MANUAL)
  targetDate     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([buyerWalletId])
  @@index([status])
}

//////////////////////////////////////////////////////
// MARKET ORDERS & MATCHES
//////////////////////////////////////////////////////

enum OrderSide {
  BID
  OFFER
}

enum OrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

model MarketRun {
  id         String    @id @default(uuid())
  marketType MarketType @default(DAY_AHEAD)
  runTime    DateTime
  status     String
  startAt    DateTime?
  endAt      DateTime?
  clearedAt  DateTime?
  createdAt  DateTime  @default(now())

  matches    MarketMatch[]
}

model MarketOrder {
  id           String     @id @default(uuid())
  side         OrderSide
  marketType   MarketType @default(DAY_AHEAD)
  participantEmail String? 
  walletId     String?
  buildingName String?
  sourceType   String?     // e.g. solar, battery, grid
  quantity     Decimal    @db.Decimal(12, 4)
  filled       Decimal    @db.Decimal(12, 4) @default(0)
  price        Decimal?   @db.Decimal(12, 4)
  status       OrderStatus @default(OPEN)
  targetDate   DateTime?
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  participant  User?      @relation("MarketOrderParticipant", fields: [participantEmail], references: [email])
  building     Building?  @relation("MarketOrderBuilding", fields: [buildingName], references: [name])

  buyerMatches MarketMatch[] @relation("buyerOrder")
  sellerMatches MarketMatch[] @relation("sellerOrder")

  @@index([marketType])
  @@index([status])
  @@index([buildingName])
}

model MarketMatch {
  id            String   @id @default(uuid())
  runId         String?
  buyerOrderId  String
  sellerOrderId String
  quantity      Decimal  @db.Decimal(12, 4)
  price         Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  run    MarketRun?  @relation(fields: [runId], references: [id])
  buyer  MarketOrder @relation("buyerOrder", fields: [buyerOrderId], references: [id])
  seller MarketOrder @relation("sellerOrder", fields: [sellerOrderId], references: [id])

  @@index([runId])
  @@index([buyerOrderId])
  @@index([sellerOrderId])
}

//////////////////////////////////////////////////////
// LOG / NOTIFICATION
//////////////////////////////////////////////////////

model ActivityLog {
  id           Int      @id @default(autoincrement())
  email        String
  activitytype String
  detail       Json
  createdAt    DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  email     String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// BATTERY / BLOCKCHAIN
//////////////////////////////////////////////////////

model Battery {
  snid                String   @unique
  capacitykWH       Float
  currentkWH        Float  @default(0)
  currentPercentage Float  @default(0)
  buildingId        Int
  ownerId           String   @db.Uuid
  createdAt         DateTime @default(now())
}

model BlockTransaction {
  id         String   @id @default(uuid())
  receiptId  String
  txHash     String?  @unique
  appTxId    String?
  payloadHash String?
  status     String?
  chainId    Int?
  explorerUrl String?
  verificationMethod String?
  contractAddress String?
  height     Float?
  txAmount   Float?
  blockHash  String?
  parentHash String?
  validator  String?
  gasUsed    Float?
  txFee      Float?
  blockSize  Float?
  timestamp  DateTime?
  createdAt  DateTime @default(now())
}

model Transaction {
  txid       String    @id @default(uuid()) @map("id")
  walletId   String?
  buildingId Int?
  buildingName String?
  snid       String?
  type       String?
  tokenAmount Float?   @map("amount")
  status     TxStatus?
  timestamp  DateTime? @default(now())

  verificationStatus  String?
  verificationMethod  String?
  chainId             Int?
  verificationPayload String?
  payloadHash         String?
  txHash              String?  @unique
  explorerUrl         String?
  publisherAddress    String?
  contractAddress     String?
  blockNumber         Float?
  gasUsed             String?
  effectiveGasPrice   String?
  verifiedAt          DateTime?

  wallet   Wallet?   @relation(fields: [walletId], references: [id])
  building Building? @relation(fields: [buildingId], references: [id])

  @@index([walletId])
  @@index([buildingName])
  @@index([snid])
  @@index([txHash])
}
